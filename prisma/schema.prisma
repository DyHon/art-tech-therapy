// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  personaMask   Json?          // Public-facing profile data & preferences
  shadowNodes   String[]       // Key themes repressed/identified for AI context
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entries       JournalEntry[]
  snapshots     UserSnapshot[]
}

enum EntryType {
  DREAM
  REFLECTION
  ACTIVE_IMAGINATION
  CINEMATIC_RESPONSE
}

model JournalEntry {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentEncrypted String           @db.Text
  entryType        EntryType        @default(REFLECTION)
  // 1536 is standard for text-embedding-004 (Gemini) or text-embedding-3-small (OpenAI)
  embedding        Unsupported("vector(1536)")?
  analysisJson     Json             // The structured output from the Alchemist AI
  createdAt        DateTime         @default(now())
  archetypalTags   ArchetypalTag[]

  @@index([userId])
}

model ArchetypalTag {
  id             String       @id @default(uuid())
  entryId        String
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  archetypeName  String       // e.g., 'Shadow', 'Anima', 'Trickster'
  intensityScore Int          // 1-10
  symbolicMotifs String[]     // e.g., ['ocean', 'snake', 'clock']
  isIntegrated   Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([entryId])
}

model UserSnapshot {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // The fluid distribution of the 4 Jungian Functions
  // Expected Format: { "thinking": 0.85, "feeling": 0.12, "sensation": 0.30, "intuition": 0.55 }
  psychologicalFunctions Json     

  tensionIndex          Decimal  @db.Decimal(4, 3) // 0.000 to 1.000 (Global psychic conflict)
  shadowScore           Decimal  @db.Decimal(4, 3) // 0.000 to 1.000 (Level of shadow awareness)

  // User's IANA timezone (resolved from personaMask) at record time, so the dashboard can
  // bucket time-series by the user's local day instead of blindly trusting server UTC.
  timezone              String   @default("UTC")
  recordedAt            DateTime @default(now())

  @@index([userId, recordedAt])
}
